{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trace",
  "version": "0.1.0",
  "identifier": "local.trace.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build && npm run sidecar",
      "cwd": "../.."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/trace-agent"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Free, private mouse activity insights for your desktop",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Trace",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
