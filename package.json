{
  "name": "trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "test:bridge": "node --test scripts/local-collector.test.mjs",
    "test:windows": "node scripts/smoke-windows.mjs",
    "status": "node scripts/collector-status.mjs",
    "build": "tsc --noEmit -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "desktop": "node scripts/run-desktop.mjs dev",
    "sidecar": "node scripts/build-sidecar.mjs",
    "installer": "node scripts/run-desktop.mjs build",
    "test": "vitest run --config apps/desktop/vite.config.ts",
    "test:rust": "cargo test",
    "test:load": "cargo run --release -p trace-agent -- --simulate",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "echarts": "^6",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "prettier": "^3.9.9",
    "typescript": "^5.7",
    "vite": "^6",
    "vitest": "^4.1.11"
  }
}
